{
  "name": "dsh-webhook-bridge",
  "version": "0.1.0",
  "description": "DSH (DeepSeek Harness) webhook 桥接：受共享密钥保护的 HTTP 入口，收到请求即创建一个新的 Workspace 会话并投递 prompt；支持同步等待并回传该会话的回复正文。",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "webhook",
    "openclaw",
    "weixin"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-webhook": "0.1.7-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-webhook": {
      "optional": false
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-util-values": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "*"
  }
}
